<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стиль для заголовка тулбара -->
    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Тема для кастомных диалогов -->
    <style name="CustomDialogTheme" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowIsFloating">true</item>
        <item name="colorSurface">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/CustomDialogStyle</item>
    </style>

    <style name="CustomDialogStyle" parent="MaterialAlertDialog.MaterialComponents">
        <item name="android:background">@android:color/transparent</item>
        <item name="background">@android:color/transparent</item>
    </style>
</resources>